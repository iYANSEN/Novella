{
  
[
  "expo-notifications",
  {
    "icon": "./assets/icon.png",
    "color": "#7c3aed"
  }
]



  
  "expo": {
    "name": "Novella",
    "slug": "novella",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novella.reader",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used for TTS playback control",
        "UIBackgroundModes": ["audio", "fetch"]
      }
    },
    "android": {
  "adaptiveIcon": {
    "foregroundImage": "./assets/adaptive-icon.png",
    "backgroundColor": "#0d0d14"
  },
  "package": "com.novella.reader",
  "newArchEnabled": false,
  "permissions": [
    "android.permission.INTERNET",
    "android.permission.READ_EXTERNAL_STORAGE",
    "android.permission.WRITE_EXTERNAL_STORAGE",
    "android.permission.FOREGROUND_SERVICE",
    "android.permission.RECEIVE_BOOT_COMPLETED"
  ]
},
      "package": "com.novella.reader",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
"plugins": [
  "expo-router",
  "expo-dev-client",
  "expo-secure-store",
  [
    "expo-notifications",
    {
      "icon": "./assets/icon.png",
      "color": "#7c3aed"
    }
  ]
],
    "scheme": "novella",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "343b5004-ec59-4048-951b-330922f6f0d6"
      },
      "router": {
        "origin": false
      }
    }
  }
}
